# Supabase — copy this file to .env.local and fill in real values.
# .env.local is gitignored. Never commit real keys.

# Project URL — from Supabase Dashboard → Project Settings → Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (sb_publishable_...) — safe in the browser
# From Supabase Dashboard → Project Settings → API Keys → Publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Secret key (sb_secret_...) — SERVER ONLY, never expose to the browser
# From Supabase Dashboard → Project Settings → API Keys → Secret keys
SUPABASE_SECRET_KEY=sb_secret_your_key_here

TWOFA_SECRET=your-random-32-byte-hex-secret
RESEND_API_KEY=re_your_resend_api_key
